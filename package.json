{
  "name": "@vue-aplayer/customizable-ui",
  "version": "0.1.0",
  "description": "Easy-to-use music player for Vue 2.x",
  "main": "dist/vue-aplayer.min.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "webpack serve --config webpack.demo.config.js",
    "build": "webpack --mode production --progress",
    "build:demo": "webpack --mode production --progress --config webpack.demo.config.js",
    "prepublishOnly": "npm run build",
    "pack": "npm pack",
    "predeploy": "npm add hls.js && npm run build:demo && echo 'vue-aplayer.js.org' > demo/CNAME",
    "lint": "eslint --ext .js,.vue src",
    "test": "npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ta-yamazaki/vue-aplayer.git"
  },
  "keywords": [
    "vue",
    "aplayer",
    "vue-aplayer",
    "music-player",
    "html5",
    "component",
    "vue-compoents"
  ],
  "author": {
    "name": "ta-yamazaki",
    "url": "https://github.com/ta-yamazaki"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ta-yamazaki/vue-aplayer_ui-customizable/issues"
  },
  "homepage": "https://github.com/ta-yamazaki/vue-aplayer_ui-customizable#readme",
  "peerDependencies": {
    "vue": "^2.5.16"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-stage-2": "^7.8.3",
    "autoprefixer": "9.6.1",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "cz-conventional-changelog": "2.1.0",
    "eslint": "^7.32.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-vue": "^9.33.0",
    "file-loader": "^6.2.0",
    "hls.js": "^0.12.4",
    "html-webpack-plugin": "^5.6.3",
    "postcss-loader": "^8.1.1",
    "raw-loader": "^4.0.2",
    "sass": "^1.89.0",
    "sass-loader": "^10.5.2",
    "style-loader": "^4.0.0",
    "url-loader": "^4.1.1",
    "vue": "2.6.10",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "2.6.10",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
